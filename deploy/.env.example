# Compose 基线变量示例（不要填入真实凭据）
COMPOSE_PROJECT_NAME=zero-server
ZERO_APP_IMAGE=ghcr.io/your-org/your-game-server:replace-me
ZERO_ENV=compose
ZERO_BIND_ADDRESS=127.0.0.1
ZERO_HTTP_PORT=8080
ZERO_GAME_PORT=9000
ZERO_CONFIG_SECRET_FILE=./secrets/zero-config
ZERO_POSTGRES_PASSWORD_FILE_HOST=./secrets/postgres-password
# 外部中间件可选；启用内置 profile 时 app 默认使用 compose 网络别名。
# ZERO_REDIS_URI=redis://redis:6379
# ZERO_POSTGRESQL_URL=jdbc:postgresql://postgres:5432/zero
