<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>group.zn.zero</groupId><artifactId>zero-parent</artifactId><version>0.1.2-SNAPSHOT</version>
        <relativePath>../../zero-parent/pom.xml</relativePath>
    </parent>
    <artifactId>zero-example-module-recipes</artifactId>
    <packaging>pom</packaging>
    <name>zeroServer Module Recipes</name>
    <modules>
        <module>runtime-basics</module>
        <module>event-actor</module>
        <module>discovery</module>
        <module>npc</module>
        <module>ownership</module>
        <module>gm</module>
        <module>production</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.3</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><failIfNoTests>true</failIfNoTests></configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.3.0</version>
                    <configuration><mainClass>${exec.mainClass}</mainClass></configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
