<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>group.zn.zero.examples</groupId>
    <artifactId>repository-composition</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <zero.repository.report-directory>${project.build.directory}/failsafe-reports</zero.repository.report-directory>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>group.zn.zero</groupId><artifactId>zero-bom</artifactId><version>0.1.0-SNAPSHOT</version>
                <type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>group.zn.zero</groupId><artifactId>zero-runtime-data</artifactId></dependency>
        <dependency><groupId>group.zn.zero</groupId><artifactId>zero-runtime-mongo</artifactId></dependency>
        <dependency><groupId>group.zn.zero</groupId><artifactId>zero-runtime-postgresql</artifactId></dependency>
        <dependency><groupId>group.zn.zero</groupId><artifactId>zero-runtime-redis</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.3</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
                <configuration><mainClass>group.zn.zero.examples.repository.RepositoryCompositionApplication</mainClass></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>repository-external</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.2.5</version>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                <configuration>
                    <forkedProcessTimeoutInSeconds>180</forkedProcessTimeoutInSeconds>
                    <reportsDirectory>${zero.repository.report-directory}</reportsDirectory>
                    <summaryFile>${zero.repository.report-directory}/failsafe-summary.xml</summaryFile>
                    <includes><include>**/RepositoryDriverContractIT.java</include></includes>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>repository-resilience</id>
            <properties><zero.repository.fork-timeout-seconds>900</zero.repository.fork-timeout-seconds></properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.2.5</version>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                <configuration>
                    <forkedProcessTimeoutInSeconds>${zero.repository.fork-timeout-seconds}</forkedProcessTimeoutInSeconds>
                    <reportsDirectory>${zero.repository.report-directory}</reportsDirectory>
                    <summaryFile>${zero.repository.report-directory}/failsafe-summary.xml</summaryFile>
                    <includes><include>**/RepositoryResilienceIT.java</include></includes>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
